# Copy to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event_booking_db

# Key that client apps send in the x-api-key header (public GET endpoints, register and login)
API_KEY=change-me-dev-key

# Comma-separated frontend URLs allowed by CORS (leave empty to allow all in development)
CORS_ORIGIN=

# JWT login (Auth & Users). Use a long random secret
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h

# bcrypt cost for password hashing (seed data uses 10)
BCRYPT_ROUNDS=10