# Copy to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event_booking_db

# Key that client apps send in the x-api-key header for public GET endpoints
API_KEY=change-me-dev-key

# Comma-separated frontend URLs allowed by CORS (leave empty to allow all in development)
CORS_ORIGIN=

# TEMPORARY: enables the dev auth stub until the real JWT middleware is merged
AUTH_STUB=true
